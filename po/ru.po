msgstr "PowerShell (администратор)"

#: rustconn/src/embedded_rdp/mod.rs:432 rustconn/src/embedded_rdp/mod.rs:1128
msgid "CMD (Admin)"
msgstr "CMD (администратор)"

#: rustconn/src/embedded_rdp/mod.rs:575 rustconn/src/embedded_rdp/mod.rs:577
msgid "Fit resolution to window"
msgstr "Подогнать разрешение под размер окна"

#: rustconn/src/embedded_rdp/mod.rs:596 rustconn/src/embedded_vnc/ui.rs:53
msgid "Copy remote clipboard to local (waiting for remote data…)"
msgstr ""
"Скопировать содержимое удалённого буфера обмена в локальный (ожидание данных "
"с удалённого компьютера…)"

#: rustconn/src/embedded_rdp/mod.rs:603 rustconn/src/embedded_vnc/ui.rs:63
msgid "Paste from local clipboard to remote session"
msgstr "Вставить из локального буфера обмена в удалённый сеанс"

#: rustconn/src/embedded_rdp/mod.rs:608 rustconn/src/embedded_rdp/mod.rs:613
msgid "Autotype"
msgstr "Автоввод"

#: rustconn/src/embedded_rdp/mod.rs:610
msgid "Send text as keystrokes (bypasses paste restrictions)"
msgstr "Отправить текст как нажатия клавиш (в обход ограничений вставки)"

#: rustconn/src/embedded_rdp/mod.rs:617
msgid "Type Clipboard"
msgstr "Ввести содержимое буфера обмена"

#: rustconn/src/embedded_rdp/mod.rs:620
msgid "Type Text…"
msgstr "Ввести текст…"

